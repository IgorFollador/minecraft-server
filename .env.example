# Copie para .env e ajuste.
# Depois de mudar: docker compose -f composer.yaml up -d
# O mundo em ./data não é apagado.
# O que cada opção faz está em README.md, seção "Opções".

# Fabric 26.3 — tem que bater com o cliente
EULA=TRUE
TYPE=FABRIC
VERSION=26.3

MEMORY=4G
MAX_PLAYERS=10

# survival, creative, adventure
MODE=survival
# peaceful, easy, normal, hard
DIFFICULTY=normal

ONLINE_MODE=TRUE
ENABLE_WHITELIST=TRUE
# Raio em blocos onde só OP constrói. 0 desliga.
SPAWN_PROTECTION=0

VIEW_DISTANCE=10
SIMULATION_DISTANCE=6

SERVER_NAME=Filhos do Velho Barreiro
# §6 dourado, §l negrito, §r limpa, §8 cinza, \n quebra a linha
MOTD=§6§lFilhos do Velho Barreiro§r\n§8Survival Fabric

ICON=/icon.png
OVERRIDE_ICON=TRUE

# Mods do Modrinth, separados por vírgula. fabric-api é o básico.
MODRINTH_PROJECTS=fabric-api
